# Maintainer: Mason Tompkins <https://github.com/masonleetompkins>
# Tracks Sonora's development branch and rebuilds from source.
_gitremote="git+https://github.com/masonleetompkins/sonora.git"

pkgname=sonora-git
pkgver=0.13.0
pkgrel=1
pkgdesc="Native Linux synthesizer and DAW: beats, arrangement, FX, recording, pitch correction"
arch=('x86_64')
url="https://github.com/masonleetompkins/sonora"
license=('GPL-3.0-only' 'MIT' 'LicenseRef-GeneralUser-GS')
depends=('alsa-lib' 'freetype2' 'fontconfig' 'libx11' 'libxext' 'libxinerama'
         'libxrandr' 'libxcursor' 'libgl' 'gtk3' 'webkit2gtk-4.1' 'libcurl'
         'pipewire-jack')
makedepends=('git' 'cmake' 'ninja' 'pkgconf' 'gcc')
provides=('sonora')
conflicts=('sonora')
source=("${pkgname}::${_gitremote}")
sha256sums=('SKIP')

pkgver() {
  cd "${srcdir}/${pkgname}"
  # Produces 0.13.0.r<commits>.g<hash> when tags like v0.13.0 exist.
  git describe --long --tags 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  cmake -S "${srcdir}/${pkgname}" -B "${srcdir}/${pkgname}/build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=OFF
  cmake --build "${srcdir}/${pkgname}/build" --parallel "$(nproc)"
}

check() {
  # Reconfigure the same tree with tests enabled and run the suite.
  cmake -S "${srcdir}/${pkgname}" -B "${srcdir}/${pkgname}/build" -DBUILD_TESTING=ON
  cmake --build "${srcdir}/${pkgname}/build" --parallel "$(nproc)" --target SonoraTests
  ctest --test-dir "${srcdir}/${pkgname}/build" --output-on-failure
}

package() {
  # NOTE: plain `cmake --install` would also stage all of JUCE's own headers
  # (JUCE offers no install toggle), so the package installs files explicitly.
  local src="${srcdir}/${pkgname}"
  install -Dm755 "${src}/build/Sonora_artefacts/Release/Sonora" "${pkgdir}/usr/bin/Sonora"
  install -Dm644 "${src}/packaging/sonora.desktop" "${pkgdir}/usr/share/applications/sonora.desktop"
  install -Dm644 "${src}/assets/sonora.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/sonora.svg"
  install -Dm644 "${src}/packaging/org.sonora.Sonora.metainfo.xml" "${pkgdir}/usr/share/metainfo/org.sonora.Sonora.metainfo.xml"
  install -Dm644 "${src}/LICENSE" "${pkgdir}/usr/share/licenses/sonora/LICENSE"
  # Sampled instruments: Sonora finds the bank at ../share/sonora relative to the binary.
  install -Dm644 "${src}/assets/GeneralUser-GS.sf2" "${pkgdir}/usr/share/sonora/GeneralUser-GS.sf2"
  install -Dm644 "${src}/assets/GeneralUser-GS-LICENSE.txt" "${pkgdir}/usr/share/licenses/sonora/GeneralUser-GS-LICENSE.txt"
  install -Dm644 "${src}/third_party/TinySoundFont-LICENSE" "${pkgdir}/usr/share/licenses/sonora/TinySoundFont-LICENSE"
}
